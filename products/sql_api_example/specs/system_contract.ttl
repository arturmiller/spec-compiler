@prefix article: <https://arturmiller.github.io/spec-compiler/resources/sql-api/#> .
@prefix sco: <https://arturmiller.github.io/spec-compiler/ontology/#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Technisch: Wo wird ein Artikel ausgegeben und gespeichert?
article:GetArticleEndpoint
    a sco:GetEndpoint ;
    sco:path "/articles/{id}" ;
    sco:pathParameter [
        sco:name "id" ;
        sh:datatype xsd:integer ;
        sco:mapsToColumn "id" ;
    ] ;
    sco:successStatus 200 ;
    sco:mediaType "application/json" ;
    sco:readsFrom article:ArticlesTable ;
    sco:returns article:ArticleShape .

article:ArticlesTable
    a sco:SqlTable ;
    sco:databaseEngine sco:SQLite ;
    sco:tableName "articles" ;
    sco:idColumn "id" ;
    sco:idDatatype xsd:integer ;
    sco:idPrimaryKey true ;
    sco:idGenerated true ;
    sco:stores article:ArticleShape .
