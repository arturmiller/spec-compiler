@prefix sqlo: <https://arturmiller.github.io/spec-compiler/ontology/sql/#> .
@prefix article: <https://arturmiller.github.io/spec-compiler/resources/sql-api/#> .
@prefix sco: <https://arturmiller.github.io/spec-compiler/ontology/#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Technisch: Wo wird ein Artikel ausgegeben und gespeichert?
article:GetArticleEndpoint
    a sco:GetEndpoint ;
    sco:path "/articles/{id}" ;
    sco:pathParameter [
        sco:name "id" ;
        sh:datatype xsd:integer ;
        sqlo:mapsToColumn "id" ;
    ] ;
    sco:successStatus 200 ;
    sco:mediaType "application/json" ;
    sqlo:readsFrom article:ArticlesTable ;
    sco:returns article:ArticleShape .

article:ArticlesTable
    a sqlo:SqlTable ;
    sqlo:databaseEngine sqlo:SQLite ;
    sqlo:tableName "articles" ;
    sqlo:idColumn "id" ;
    sqlo:idDatatype xsd:integer ;
    sqlo:idPrimaryKey true ;
    sqlo:idGenerated true ;
    sqlo:stores article:ArticleShape .
