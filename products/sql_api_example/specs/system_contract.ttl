@prefix ex: <https://example.org/catalog/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Technisch: Wo wird ein Artikel ausgegeben und gespeichert?
ex:GetArticleEndpoint
    a ex:GetEndpoint ;
    ex:path "/articles/{id}" ;
    ex:pathParameter [
        ex:name "id" ;
        sh:datatype xsd:integer ;
        ex:mapsToColumn "id" ;
    ] ;
    ex:successStatus 200 ;
    ex:mediaType "application/json" ;
    ex:readsFrom ex:ArticlesTable ;
    ex:returns ex:ArticleShape .

ex:ArticlesTable
    a ex:SqlTable ;
    ex:databaseEngine ex:SQLite ;
    ex:tableName "articles" ;
    ex:idColumn "id" ;
    ex:idDatatype xsd:integer ;
    ex:idPrimaryKey true ;
    ex:idGenerated true ;
    ex:stores ex:ArticleShape .
