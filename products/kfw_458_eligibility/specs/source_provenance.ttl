kfw458:CitationEligibleApplicants a sdo:SourceCitation ;
    sdo:citesSourceRevision kfw458:Kfw458Merkblatt2026_07 ;
    sdo:sourceLocator "PDF page 2, section 'Wer kann Anträge stellen?', eligible applicant categories" ;
    sdo:sourceStatement "Natural persons who own existing residential buildings in Germany are within the listed eligible applicant categories." .

kfw458:CitationGbRExclusion a sdo:SourceCitation ;
    sdo:citesSourceRevision kfw458:Kfw458Merkblatt2026_07 ;
    sdo:sourceLocator "PDF page 2, section 'Wer kann Anträge stellen?', first explicit exclusion" ;
    sdo:sourceStatement "A GbR entered as owner and its partners are not eligible applicants." .

kfw458:CitationUsufructExclusion a sdo:SourceCitation ;
    sdo:citesSourceRevision kfw458:Kfw458Merkblatt2026_07 ;
    sdo:sourceLocator "PDF page 2, section 'Wer kann Anträge stellen?', second explicit exclusion" ;
    sdo:sourceStatement "A person for whom a usufruct right to a residential building has been established is not an eligible applicant." .

kfw458:CitationOwnershipEvidenceForApplicantBonus a sdo:SourceCitation ;
    sdo:citesSourceRevision kfw458:Kfw458Merkblatt2026_07 ;
    sdo:sourceLocator "PDF page 8, section 'Nachweise', first paragraph" ;
    sdo:sourceStatement "Self-using owners claiming the climate-speed bonus or income bonus must submit a land-register excerpt as evidence of ownership." .
