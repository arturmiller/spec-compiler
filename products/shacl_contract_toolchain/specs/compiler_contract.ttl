@prefix ex: <https://example.org/catalog/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

ex:ShaclContractToolchain a schema:SoftwareApplication ;
    dcterms:conformsTo ex:CompilerProtocolV1 ;
    ex:implementsContract ex:ShaclContractCompilationV1 .

ex:ShaclContractCompilationV1 a ex:TransformationContract ;
    ex:inputSpecPattern "specs/*.ttl" ;
    ex:validFixtureProduct "../sql_api_example" ;
    ex:generatesArtifact "tests/test_contract.py" ,
        "generated/expected-openapi.json" ,
        "generated/work-graph.json" ,
        "generated/issues/*.md" ;
    ex:rejectsMissingSpecs true ;
    ex:deterministicOutput true .
