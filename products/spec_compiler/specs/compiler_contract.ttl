@prefix sco: <https://arturmiller.github.io/spec-compiler/ontology/#> .
@prefix tool: <https://arturmiller.github.io/spec-compiler/resources/toolchain/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

tool:SpecCompiler a schema:SoftwareApplication ;
    dcterms:conformsTo sco:CompilerProtocolV1 ;
    sco:implementsContract tool:SpecCompilationV1 .

tool:SpecCompilerG0 a schema:SoftwareApplication ;
    dcterms:isVersionOf tool:SpecCompiler .

tool:SpecCompilerBootstrapV1 a sco:BootstrapProcess ;
    sco:bootstrapsProduct tool:SpecCompiler ;
    sco:seedImplementation tool:SpecCompilerG0 ;
    sco:evolutionStrategy sco:ModifyExistingImplementation ;
    sco:generatesImplementationArtifact "src/spec_compiler.py" .

tool:SpecCompilationV1 a sco:TransformationContract ;
    sco:inputSpecPattern "specs/*.ttl" ;
    sco:conformanceFixture
        tool:SqlApiFixture,
        tool:Kfw458Fixture,
        tool:CloudAccessComplianceFixture ;
    sco:rejectsMissingSpecs true ;
    sco:deterministicOutput true .

tool:SqlApiFixture a sco:CompilerConformanceFixture ;
    sco:fixtureProduct "../sql_api_example" ;
    sco:expectsArtifact "tests/test_contract.py" ,
        "generated/expected-openapi.json" ,
        "generated/work-graph.json" ,
        "generated/issues/*.md" .

tool:Kfw458Fixture a sco:CompilerConformanceFixture ;
    sco:fixtureProduct "../kfw_458_eligibility" ;
    sco:expectsArtifact "tests/test_contract.py" ,
        "tests/test_http_contract.py" ,
        "generated/decision-contract.json" ,
        "generated/expected-openapi.json" ,
        "generated/work-graph.json" ,
        "generated/issues/*.md" .

tool:CloudAccessComplianceFixture a sco:CompilerConformanceFixture ;
    sco:fixtureProduct "../cloud_access_compliance" ;
    sco:expectsArtifact "tests/test_contract.py" ,
        "generated/decision-contract.json" ,
        "generated/work-graph.json" ,
        "generated/issues/*.md" .
