@prefix cco: <https://arturmiller.github.io/spec-compiler/ontology/compiler/#> .
@prefix tool: <https://arturmiller.github.io/spec-compiler/resources/toolchain/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

tool:SpecCompiler a schema:SoftwareApplication ;
    dcterms:conformsTo cco:CompilerProtocolV1 ;
    cco:implementsContract tool:SpecCompilationV1 .

tool:SpecCompilerG0 a schema:SoftwareApplication ;
    dcterms:isVersionOf tool:SpecCompiler .

tool:SpecCompilerBootstrapV1 a cco:BootstrapProcess ;
    cco:bootstrapsProduct tool:SpecCompiler ;
    cco:seedImplementation tool:SpecCompilerG0 ;
    cco:evolutionStrategy cco:ModifyExistingImplementation ;
    cco:generatesImplementationArtifact "src/spec_compiler.py" .

tool:SpecCompilationV1 a cco:TransformationContract ;
    cco:inputSpecPattern "specs/*.ttl" ;
    cco:conformanceFixture
        tool:SqlApiFixture,
        tool:Kfw458Fixture,
        tool:CloudAccessComplianceFixture ;
    cco:rejectsMissingSpecs true ;
    cco:deterministicOutput true .

tool:SqlApiFixture a cco:CompilerConformanceFixture ;
    cco:fixtureProduct "../sql_api_example" ;
    cco:expectsArtifact "tests/test_contract.py" ,
        "generated/expected-openapi.json" ,
        "generated/work-graph.json" ,
        "generated/issues/*.md" .

tool:Kfw458Fixture a cco:CompilerConformanceFixture ;
    cco:fixtureProduct "../kfw_458_eligibility" ;
    cco:expectsArtifact "tests/test_contract.py" ,
        "tests/test_http_contract.py" ,
        "generated/decision-contract.json" ,
        "generated/expected-openapi.json" ,
        "generated/work-graph.json" ,
        "generated/issues/*.md" .

tool:CloudAccessComplianceFixture a cco:CompilerConformanceFixture ;
    cco:fixtureProduct "../cloud_access_compliance" ;
    cco:expectsArtifact "tests/test_contract.py" ,
        "generated/decision-contract.json" ,
        "generated/work-graph.json" ,
        "generated/issues/*.md" .
