@prefix funding: <https://arturmiller.github.io/spec-compiler/ontology/funding/#> .
@prefix sdo: <https://arturmiller.github.io/spec-compiler/ontology/decision/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://arturmiller.github.io/spec-compiler/ontology/funding/>
    a owl:Ontology ;
    dcterms:title "Funding Domain Ontology"@en ;
    dcterms:title "Förderdomänenontologie"@de ;
    dcterms:description "Domain vocabulary for funding programs and scoped eligibility decisions."@en ;
    dcterms:description "Domänenvokabular für Förderprogramme und abgegrenzte Förderfähigkeitsentscheidungen."@de ;
    dcterms:creator <https://github.com/arturmiller> ;
    dcterms:source <https://github.com/arturmiller/spec-compiler> ;
    vann:preferredNamespacePrefix "funding" ;
    vann:preferredNamespaceUri "https://arturmiller.github.io/spec-compiler/ontology/funding/#" ;
    owl:imports <https://arturmiller.github.io/spec-compiler/ontology/decision/> ;
    owl:versionInfo "0.3.0-experimental" .

funding:FundingProgram a owl:Class ;
    rdfs:label "Funding program"@en ;
    rdfs:label "Förderprogramm"@de .

funding:Applicant a owl:Class ;
    rdfs:label "Applicant"@en ;
    rdfs:label "Antragstellende Person"@de ;
    rdfs:comment "Die im Fall betrachtete antragstellende Person. Ihre Eigenschaften werden von den Regeln geprüft; sie ist weder der Entscheidungsvertrag noch eine Zusage des Fördergebers."@de .

funding:Project a owl:Class ;
    rdfs:label "Project"@en ;
    rdfs:label "Vorhaben"@de ;
    rdfs:comment "Das im Fall betrachtete Vorhaben mit seinen ausdrücklich angegebenen Eigenschaften, etwa Standort und Gebäudebestand. Es ist von der antragstellenden Person getrennt."@de .

funding:LandRegisterExcerpt a owl:Class ;
    rdfs:subClassOf sdo:Evidence ;
    rdfs:label "Land-register excerpt"@en ;
    rdfs:label "Grundbuchauszug"@de .

funding:ApplicantEligibilityDecision a owl:Class ;
    rdfs:subClassOf sdo:DecisionContract ;
    rdfs:label "Applicant eligibility decision"@en ;
    rdfs:label "Entscheidung über Antragsberechtigung"@de .

funding:Eligible a owl:NamedIndividual, sdo:DecisionOutcome ;
    rdfs:label "eligible"@en ;
    rdfs:label "antragsberechtigt"@de ;
    sdo:outcomeCode "eligible" .

funding:Ineligible a owl:NamedIndividual, sdo:DecisionOutcome ;
    rdfs:label "ineligible"@en ;
    rdfs:label "nicht antragsberechtigt"@de ;
    sdo:outcomeCode "ineligible" .

funding:Unknown a owl:NamedIndividual, sdo:DecisionOutcome ;
    rdfs:label "unknown"@en ;
    rdfs:label "unbestimmt"@de ;
    sdo:outcomeCode "unknown" .

funding:fundingProgram a owl:ObjectProperty ;
    rdfs:label "funding program"@en ;
    rdfs:label "Förderprogramm"@de ;
    rdfs:domain funding:ApplicantEligibilityDecision ;
    rdfs:range funding:FundingProgram .

funding:hasApplicant a owl:ObjectProperty ;
    rdfs:label "has applicant"@en, "hat antragstellende Person"@de ;
    rdfs:comment "Relates a concrete Case to its Applicant; does not bind a reusable Decision Contract to one person or require an RDF representation in JSON products."@en ;
    rdfs:domain sdo:Case ; rdfs:range funding:Applicant .

funding:hasProject a owl:ObjectProperty ;
    rdfs:label "has project"@en, "hat Vorhaben"@de ;
    rdfs:comment "Relates a concrete Case to its Project. It does not assert that the Applicant owns the Project or that funding has been approved."@en ;
    rdfs:domain sdo:Case ; rdfs:range funding:Project .

funding:naturalPerson a owl:DatatypeProperty ;
    rdfs:label "is a natural person"@en ;
    rdfs:label "ist eine natürliche Person"@de ;
    rdfs:domain funding:Applicant ;
    rdfs:range xsd:boolean .

funding:owner a owl:DatatypeProperty ;
    rdfs:label "is an owner"@en ;
    rdfs:label "ist Eigentümerin oder Eigentümer"@de ;
    rdfs:domain funding:Applicant ;
    rdfs:range xsd:boolean .

funding:ownershipViaGbR a owl:DatatypeProperty ;
    rdfs:label "holds ownership through a GbR"@en ;
    rdfs:label "hält Eigentum über eine GbR"@de ;
    rdfs:domain funding:Applicant ;
    rdfs:range xsd:boolean .

funding:hasUsufructRight a owl:DatatypeProperty ;
    rdfs:label "has a usufruct right"@en ;
    rdfs:label "hat ein Nießbrauchrecht"@de ;
    rdfs:domain funding:Applicant ;
    rdfs:range xsd:boolean .

funding:selfUsesResidentialProperty a owl:DatatypeProperty ;
    rdfs:label "self-uses the residential property"@en ;
    rdfs:label "nutzt die Wohnimmobilie selbst"@de ;
    rdfs:domain funding:Applicant ;
    rdfs:range xsd:boolean .

funding:claimsClimateOrIncomeBonus a owl:DatatypeProperty ;
    rdfs:label "claims a climate-speed or income bonus"@en ;
    rdfs:label "beansprucht Klimageschwindigkeits- oder Einkommensbonus"@de ;
    rdfs:domain funding:Applicant ;
    rdfs:range xsd:boolean .

funding:existingResidentialBuilding a owl:DatatypeProperty ;
    rdfs:label "concerns an existing residential building"@en ;
    rdfs:label "betrifft ein bestehendes Wohngebäude"@de ;
    rdfs:domain funding:Project ;
    rdfs:range xsd:boolean .

funding:buildingInGermany a owl:DatatypeProperty ;
    rdfs:label "building is in Germany"@en ;
    rdfs:label "Gebäude liegt in Deutschland"@de ;
    rdfs:domain funding:Project ;
    rdfs:range xsd:boolean .
