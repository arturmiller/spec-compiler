@prefix sdo: <https://arturmiller.github.io/spec-compiler/ontology/decision/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://arturmiller.github.io/spec-compiler/ontology/decision/>
    a owl:Ontology ;
    dcterms:title "Decision and Obligation Core Ontology"@en ;
    dcterms:title "Kernontologie für Entscheidungen und Verpflichtungen"@de ;
    dcterms:description "Domain-independent vocabulary for source-backed decisions and obligations."@en ;
    dcterms:description "Domänenunabhängiges Vokabular für quellengestützte Entscheidungen und Verpflichtungen."@de ;
    dcterms:creator <https://github.com/arturmiller> ;
    dcterms:source <https://github.com/arturmiller/spec-compiler> ;
    vann:preferredNamespacePrefix "sdo" ;
    vann:preferredNamespaceUri "https://arturmiller.github.io/spec-compiler/ontology/decision/#" ;
    owl:versionInfo "0.5.0-experimental" .

sdo:DecisionContract a owl:Class ;
    rdfs:label "Decision contract"@en ;
    rdfs:label "Entscheidungsvertrag"@de ;
    rdfs:comment "Versioned specification of a decision question, accepted Case facts, candidate Rule Set Versions, outcomes, and observable result obligations."@en .

sdo:RuleSet a owl:Class ;
    rdfs:label "Rule set"@en ;
    rdfs:label "Regelwerk"@de .

sdo:RuleSetVersion a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty dcterms:isVersionOf ; owl:allValuesFrom sdo:RuleSet ] ;
    rdfs:label "Rule set version"@en ;
    rdfs:label "Regelwerkversion"@de .

sdo:Rule a owl:Class ;
    rdfs:label "Rule"@en ;
    rdfs:label "Regel"@de .

sdo:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:label "Bedingung"@de .

sdo:Case a owl:Class ;
    rdfs:label "Case"@en ;
    rdfs:label "Fall"@de .

sdo:Fact a owl:Class ;
    rdfs:label "Fact"@en ;
    rdfs:label "Fallsachverhalt"@de .

sdo:CaseFact a owl:Class ;
    rdfs:subClassOf sdo:Fact ;
    rdfs:label "Case fact"@en ;
    rdfs:label "Fallsachverhalt"@de .

sdo:FactGap a owl:Class ;
    rdfs:label "Fact gap"@en ;
    rdfs:label "Sachverhaltslücke"@de ;
    rdfs:comment "Absence of a Fact required to evaluate a Condition; it is not a false Fact."@en ;
    rdfs:comment "Im Entscheidungsergebnis festgehaltene fehlende Eingabe für eine bestimmte Bedingung. Eine Lücke ist kein falscher Sachverhalt und kann auch neben einem bereits negativen Ausgang bestehen."@de .

sdo:FactQuestion a owl:Class ;
    rdfs:label "Fact question"@en ;
    rdfs:label "Sachverhaltsfrage"@de ;
    rdfs:comment "An authored prompt that can elicit one Fact required to evaluate a Condition."@en .

sdo:DecisionResult a owl:Class ;
    rdfs:label "Decision result"@en ;
    rdfs:label "Entscheidungsergebnis"@de ;
    rdfs:comment "The result of evaluating one request: identifies the contract, selected rule set version and outcome, and contains condition evaluations, fact gaps and obligation evaluations. It is not merely the outcome code and does not prescribe a serialization."@en ;
    rdfs:comment "Ergebnis einer konkreten Anfrage mit Entscheidungsvertrag, gewählter Regelwerkversion und Ausgang sowie Bedingungsauswertungen, Sachverhaltslücken und Verpflichtungsauswertungen. Es ist mehr als der Ausgang allein und legt kein Übertragungsformat fest."@de .

sdo:DecisionOutcome a owl:Class ;
    rdfs:label "Decision outcome"@en ;
    rdfs:label "Entscheidungsausgang"@de .

sdo:ConditionEvaluation a owl:Class ;
    rdfs:label "Condition evaluation"@en ;
    rdfs:label "Bedingungsauswertung"@de ;
    rdfs:comment "The satisfied, violated or unknown evaluation of a condition in the context of one rule and one decision result; not a change to the condition definition."@en ;
    rdfs:comment "Bewertung einer Bedingung im Zusammenhang mit einer bestimmten Regel und einem konkreten Entscheidungsergebnis: erfüllt, verletzt oder unbestimmt. Die Bedingungsdefinition selbst bleibt unverändert."@de .

sdo:Obligation a owl:Class ;
    rdfs:label "Obligation"@en ;
    rdfs:label "Verpflichtung"@de ;
    rdfs:comment "A normative requirement explicitly imposed by a Rule; its evaluation inherits that Rule's Condition and Source Citation."@en .

sdo:ObligationEvaluation a owl:Class ;
    rdfs:label "Obligation evaluation"@en ;
    rdfs:label "Verpflichtungsauswertung"@de ;
    rdfs:comment "The fulfilled, violated, or unknown status of one Obligation for one Case."@en ;
    rdfs:comment "Bewertung einer konkreten Verpflichtung innerhalb eines Entscheidungsergebnisses mit dem Status erfüllt, verletzt oder unbestimmt. Die Verpflichtung bleibt von ihrer Bewertung und von einer Testerwartung getrennt."@de .

sdo:ObligationExpectation a owl:Class ;
    rdfs:label "Obligation expectation"@en ;
    rdfs:label "Verpflichtungserwartung"@de ;
    rdfs:comment "The expected Obligation status in a Conformance Case."@en .

sdo:ObligationStatus a owl:Class ;
    rdfs:label "Obligation status"@en ;
    rdfs:label "Verpflichtungsstatus"@de .

sdo:ObligationFulfilled a owl:NamedIndividual, sdo:ObligationStatus ;
    rdfs:label "fulfilled"@en ;
    rdfs:label "erfüllt"@de .

sdo:ObligationViolated a owl:NamedIndividual, sdo:ObligationStatus ;
    rdfs:label "violated"@en ;
    rdfs:label "verletzt"@de .

sdo:ObligationUnknown a owl:NamedIndividual, sdo:ObligationStatus ;
    rdfs:label "unknown"@en ;
    rdfs:label "unbestimmt"@de .

sdo:ConformanceCase a owl:Class ;
    rdfs:subClassOf sdo:Case ;
    rdfs:label "Conformance case"@en ;
    rdfs:label "Konformitätsfall"@de .

sdo:QuestionFlowCase a owl:Class ;
    rdfs:subClassOf sdo:ConformanceCase ;
    rdfs:label "question flow case"@en ;
    rdfs:label "Frageablauf-Konformitätsfall"@de ;
    rdfs:comment "A complete positive Conformance Case whose Facts are supplied as answers in the generated multi-step question-flow proof."@en .

sdo:VersionSelectionCase a owl:Class ;
    rdfs:subClassOf sdo:ConformanceCase ;
    rdfs:label "version selection case"@en ;
    rdfs:label "Versionsauswahl-Konformitätsfall"@de ;
    rdfs:comment "A Conformance Case that proves temporal Rule Set Version selection from its explicit Decision Date."@en .

sdo:EvidenceRequirement a owl:Class ;
    rdfs:label "Evidence requirement"@en ;
    rdfs:label "Nachweisanforderung"@de ;
    rdfs:comment "An independently sourced requirement for Evidence that supports a Condition without determining that Condition's truth."@en .

sdo:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:label "Nachweis"@de ;
    rdfs:comment "Supplied information or an artifact offered for an Evidence Requirement; presence alone does not establish fulfillment."@en .

sdo:EvidenceAssessment a owl:Class ;
    rdfs:label "Evidence assessment"@en ;
    rdfs:label "Nachweisbewertung"@de ;
    rdfs:comment "An explicit acceptance or rejection of one supplied Evidence item for one Evidence Requirement."@en .

sdo:EvidenceExpectation a owl:Class ;
    rdfs:label "Evidence expectation"@en ;
    rdfs:label "Nachweiserwartung"@de ;
    rdfs:comment "The expected Evidence Requirement status in a Conformance Case."@en .

sdo:EvidenceRequirementStatus a owl:Class ;
    rdfs:label "Evidence requirement status"@en ;
    rdfs:label "Status der Nachweisanforderung"@de .

sdo:EvidenceRequirementFulfilled a owl:NamedIndividual, sdo:EvidenceRequirementStatus ;
    rdfs:label "fulfilled"@en ;
    rdfs:label "erfüllt"@de .

sdo:EvidenceRequirementMissing a owl:NamedIndividual, sdo:EvidenceRequirementStatus ;
    rdfs:label "missing"@en ;
    rdfs:label "fehlend"@de .

sdo:EvidenceRequirementNotApplicable a owl:NamedIndividual, sdo:EvidenceRequirementStatus ;
    rdfs:label "not applicable"@en ;
    rdfs:label "nicht anwendbar"@de .

sdo:Source a owl:Class ;
    rdfs:label "Source"@en ;
    rdfs:label "Quelle"@de .

sdo:SourceRevision a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty dcterms:isVersionOf ; owl:allValuesFrom sdo:Source ] ;
    rdfs:label "Source revision"@en ;
    rdfs:label "Quellenrevision"@de .

sdo:SourceCitation a owl:Class ;
    rdfs:label "Source citation"@en ;
    rdfs:label "Quellenfundstelle"@de .

# Class-local restrictions describe the existing standard version relation.
# They do not assert existence or assign conflicting global domains/ranges.
dcterms:isVersionOf rdfs:label "is version of"@en, "ist Version von"@de .

# Domain model for results; JSON field names remain a separate protocol concern.
sdo:resultForContract a owl:ObjectProperty ;
    rdfs:label "result for contract"@en, "Ergebnis für Vertrag"@de ;
    rdfs:domain sdo:DecisionResult ; rdfs:range sdo:DecisionContract .

sdo:resultRuleSetVersion a owl:ObjectProperty ;
    rdfs:label "evaluated rule set version"@en, "ausgewertete Regelwerkversion"@de ;
    rdfs:domain sdo:DecisionResult ; rdfs:range sdo:RuleSetVersion .

sdo:resultOutcome a owl:ObjectProperty ;
    rdfs:label "has outcome"@en, "hat Entscheidungsausgang"@de ;
    rdfs:domain sdo:DecisionResult ; rdfs:range sdo:DecisionOutcome .

sdo:hasConditionEvaluation a owl:ObjectProperty ;
    rdfs:label "has condition evaluation"@en, "enthält Bedingungsauswertung"@de ;
    rdfs:domain sdo:DecisionResult ; rdfs:range sdo:ConditionEvaluation .

sdo:hasFactGap a owl:ObjectProperty ;
    rdfs:label "has fact gap"@en, "enthält Sachverhaltslücke"@de ;
    rdfs:domain sdo:DecisionResult ; rdfs:range sdo:FactGap .

sdo:hasObligationEvaluation a owl:ObjectProperty ;
    rdfs:label "has obligation evaluation"@en, "enthält Verpflichtungsauswertung"@de ;
    rdfs:domain sdo:DecisionResult ; rdfs:range sdo:ObligationEvaluation .

sdo:nextQuestion a owl:ObjectProperty ;
    rdfs:label "next fact question"@en, "nächste Sachverhaltsfrage"@de ;
    rdfs:comment "A selected question, if any; the relation does not require a question to exist. Selection follows the versioned question selection conventions."@en ;
    rdfs:domain sdo:DecisionResult ; rdfs:range sdo:FactQuestion .

sdo:decisiveRule a owl:ObjectProperty ;
    rdfs:label "decisive rule"@en, "entscheidende Regel"@de ;
    rdfs:domain sdo:DecisionResult ; rdfs:range sdo:Rule .

sdo:evaluatesCondition a owl:ObjectProperty ;
    rdfs:label "evaluates condition"@en, "bewertet Bedingung"@de ;
    rdfs:domain sdo:ConditionEvaluation ; rdfs:range sdo:Condition .

sdo:evaluatedRule a owl:ObjectProperty ;
    rdfs:label "evaluated rule"@en, "ausgewertete Regel"@de ;
    rdfs:domain sdo:ConditionEvaluation ; rdfs:range sdo:Rule .

sdo:conditionEvaluationState a owl:DatatypeProperty ;
    rdfs:label "condition evaluation state"@en, "Zustand der Bedingungsauswertung"@de ;
    rdfs:comment "Decision Conventions v1 uses satisfied, violated or unknown. The literal is an evaluation state, not a Fact value."@en ;
    rdfs:domain sdo:ConditionEvaluation ; rdfs:range xsd:string .

sdo:missingFactForCondition a owl:ObjectProperty ;
    rdfs:label "missing fact for condition"@en, "fehlender Sachverhalt für Bedingung"@de ;
    rdfs:domain sdo:FactGap ; rdfs:range sdo:Condition .

sdo:evaluatesObligation a owl:ObjectProperty ;
    rdfs:label "evaluates obligation"@en, "bewertet Verpflichtung"@de ;
    rdfs:domain sdo:ObligationEvaluation ; rdfs:range sdo:Obligation .

sdo:obligationEvaluationStatus a owl:ObjectProperty ;
    rdfs:label "obligation evaluation status"@en, "ermittelter Verpflichtungsstatus"@de ;
    rdfs:domain sdo:ObligationEvaluation ; rdfs:range sdo:ObligationStatus .

sdo:usesRuleSetVersion a owl:ObjectProperty ;
    rdfs:label "uses rule set version"@en ;
    rdfs:label "verwendet Regelwerkversion"@de ;
    rdfs:domain sdo:DecisionContract ;
    rdfs:range sdo:RuleSetVersion .

sdo:hasRule a owl:ObjectProperty ;
    rdfs:label "has rule"@en ;
    rdfs:label "hat Regel"@de ;
    rdfs:domain sdo:RuleSetVersion ;
    rdfs:range sdo:Rule .

sdo:condition a owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:label "Bedingung"@de ;
    rdfs:domain sdo:Rule ;
    rdfs:range sdo:Condition .

sdo:imposesObligation a owl:ObjectProperty ;
    rdfs:label "imposes obligation"@en ;
    rdfs:label "begründet Verpflichtung"@de ;
    rdfs:domain sdo:Rule ;
    rdfs:range sdo:Obligation .

sdo:factProperty a owl:ObjectProperty ;
    rdfs:label "fact property"@en ;
    rdfs:label "Sachverhaltsproperty"@de ;
    rdfs:domain sdo:Condition ;
    rdfs:range rdf:Property .

sdo:sourceCitation a owl:ObjectProperty ;
    rdfs:label "source citation"@en ;
    rdfs:label "Quellenfundstelle"@de ;
    rdfs:domain sdo:Rule ;
    rdfs:range sdo:SourceCitation .

sdo:hasEvidenceRequirement a owl:ObjectProperty ;
    rdfs:label "has evidence requirement"@en ;
    rdfs:label "hat Nachweisanforderung"@de ;
    rdfs:domain sdo:RuleSetVersion ;
    rdfs:range sdo:EvidenceRequirement .

sdo:versionSourceCitation a owl:ObjectProperty ;
    rdfs:label "version source citation"@en ;
    rdfs:label "Quellenfundstelle der Version"@de ;
    rdfs:domain sdo:RuleSetVersion ;
    rdfs:range sdo:SourceCitation .

sdo:supportsCondition a owl:ObjectProperty ;
    rdfs:label "supports condition"@en ;
    rdfs:label "stützt Bedingung"@de ;
    rdfs:domain sdo:EvidenceRequirement ;
    rdfs:range sdo:Condition .

sdo:applicabilityCondition a owl:ObjectProperty ;
    rdfs:label "applicability condition"@en ;
    rdfs:label "Anwendbarkeitsbedingung"@de ;
    rdfs:domain sdo:EvidenceRequirement ;
    rdfs:range sdo:Condition .

sdo:requiredEvidenceType a owl:ObjectProperty ;
    rdfs:label "required evidence type"@en ;
    rdfs:label "erforderlicher Nachweistyp"@de ;
    rdfs:domain sdo:EvidenceRequirement ;
    rdfs:range owl:Class .

sdo:evidenceSourceCitation a owl:ObjectProperty ;
    rdfs:label "evidence source citation"@en ;
    rdfs:label "Quellenfundstelle der Nachweisanforderung"@de ;
    rdfs:domain sdo:EvidenceRequirement ;
    rdfs:range sdo:SourceCitation .

sdo:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence"@en ;
    rdfs:label "hat Nachweis"@de ;
    rdfs:domain sdo:Case ;
    rdfs:range sdo:Evidence .

sdo:evidenceType a owl:ObjectProperty ;
    rdfs:label "evidence type"@en ;
    rdfs:label "Nachweistyp"@de ;
    rdfs:domain sdo:Evidence ;
    rdfs:range owl:Class .

sdo:hasEvidenceAssessment a owl:ObjectProperty ;
    rdfs:label "has evidence assessment"@en ;
    rdfs:label "hat Nachweisbewertung"@de ;
    rdfs:domain sdo:Evidence ;
    rdfs:range sdo:EvidenceAssessment .

sdo:assessesEvidenceRequirement a owl:ObjectProperty ;
    rdfs:label "assesses evidence requirement"@en ;
    rdfs:label "bewertet Nachweisanforderung"@de ;
    rdfs:domain sdo:EvidenceAssessment ;
    rdfs:range sdo:EvidenceRequirement .

sdo:hasEvidenceExpectation a owl:ObjectProperty ;
    rdfs:label "has evidence expectation"@en ;
    rdfs:label "hat Nachweiserwartung"@de ;
    rdfs:domain sdo:ConformanceCase ;
    rdfs:range sdo:EvidenceExpectation .

sdo:expectsEvidenceRequirement a owl:ObjectProperty ;
    rdfs:label "expects evidence requirement"@en ;
    rdfs:label "erwartet Nachweisanforderung"@de ;
    rdfs:domain sdo:EvidenceExpectation ;
    rdfs:range sdo:EvidenceRequirement .

sdo:expectedEvidenceStatus a owl:ObjectProperty ;
    rdfs:label "expected evidence status"@en ;
    rdfs:label "erwartet Nachweisstatus"@de ;
    rdfs:domain sdo:EvidenceExpectation ;
    rdfs:range sdo:EvidenceRequirementStatus .

sdo:hasObligationExpectation a owl:ObjectProperty ;
    rdfs:label "has obligation expectation"@en ;
    rdfs:label "hat Verpflichtungserwartung"@de ;
    rdfs:domain sdo:ConformanceCase ;
    rdfs:range sdo:ObligationExpectation .

sdo:expectsObligation a owl:ObjectProperty ;
    rdfs:label "expects obligation"@en ;
    rdfs:label "erwartet Verpflichtung"@de ;
    rdfs:domain sdo:ObligationExpectation ;
    rdfs:range sdo:Obligation .

sdo:expectedObligationStatus a owl:ObjectProperty ;
    rdfs:label "expected obligation status"@en ;
    rdfs:label "erwartet Verpflichtungsstatus"@de ;
    rdfs:domain sdo:ObligationExpectation ;
    rdfs:range sdo:ObligationStatus .

sdo:citesSourceRevision a owl:ObjectProperty ;
    rdfs:label "cites source revision"@en ;
    rdfs:label "zitiert Quellenrevision"@de ;
    rdfs:domain sdo:SourceCitation ;
    rdfs:range sdo:SourceRevision .

sdo:positiveOutcome a owl:ObjectProperty ;
    rdfs:label "positive outcome"@en ;
    rdfs:label "positiver Ausgang"@de ;
    rdfs:domain sdo:DecisionContract ;
    rdfs:range sdo:DecisionOutcome .

sdo:negativeOutcome a owl:ObjectProperty ;
    rdfs:label "negative outcome"@en ;
    rdfs:label "negativer Ausgang"@de ;
    rdfs:domain sdo:DecisionContract ;
    rdfs:range sdo:DecisionOutcome .

sdo:unknownOutcome a owl:ObjectProperty ;
    rdfs:label "unknown outcome"@en ;
    rdfs:label "unbestimmter Ausgang"@de ;
    rdfs:domain sdo:DecisionContract ;
    rdfs:range sdo:DecisionOutcome .

sdo:hasConformanceCase a owl:ObjectProperty ;
    rdfs:label "has conformance case"@en ;
    rdfs:label "hat Konformitätsfall"@de ;
    rdfs:domain sdo:DecisionContract ;
    rdfs:range sdo:ConformanceCase .

sdo:forDecisionContract a owl:ObjectProperty ;
    rdfs:label "for decision contract"@en ;
    rdfs:label "für Entscheidungsvertrag"@de ;
    rdfs:domain sdo:ConformanceCase ;
    rdfs:range sdo:DecisionContract .

sdo:expectsOutcome a owl:ObjectProperty ;
    rdfs:label "expects outcome"@en ;
    rdfs:label "erwartet Ausgang"@de ;
    rdfs:domain sdo:ConformanceCase ;
    rdfs:range sdo:DecisionOutcome .

sdo:expectsRuleSetVersion a owl:ObjectProperty ;
    rdfs:label "expects rule set version"@en ;
    rdfs:label "erwartet Regelwerkversion"@de ;
    rdfs:comment "A conformance oracle for the version derived from the Decision Date; it is not a selection input."@en ;
    rdfs:domain sdo:ConformanceCase ;
    rdfs:range sdo:RuleSetVersion .

sdo:hasFact a owl:ObjectProperty ;
    rdfs:label "has fact"@en ;
    rdfs:label "hat Fallsachverhalt"@de ;
    rdfs:domain sdo:Case ;
    rdfs:range sdo:CaseFact .

sdo:forCondition a owl:ObjectProperty ;
    rdfs:label "for condition"@en ;
    rdfs:label "für Bedingung"@de ;
    rdfs:domain sdo:CaseFact ;
    rdfs:range sdo:Condition .

sdo:elicitsCondition a owl:ObjectProperty ;
    rdfs:label "elicits condition fact for"@en ;
    rdfs:label "erfragt Sachverhalt für Bedingung"@de ;
    rdfs:domain sdo:FactQuestion ;
    rdfs:range sdo:Condition .

sdo:requiresAllRules a owl:DatatypeProperty ;
    rdfs:label "requires all rules"@en ;
    rdfs:label "erfordert alle Regeln"@de ;
    rdfs:domain sdo:DecisionContract ;
    rdfs:range xsd:boolean .

sdo:expectedBoolean a owl:DatatypeProperty ;
    rdfs:label "expected boolean"@en ;
    rdfs:label "erwarteter boolescher Wert"@de ;
    rdfs:domain sdo:Condition ;
    rdfs:range xsd:boolean .

sdo:booleanValue a owl:DatatypeProperty ;
    rdfs:label "boolean value"@en ;
    rdfs:label "boolescher Wert"@de ;
    rdfs:domain sdo:CaseFact ;
    rdfs:range xsd:boolean .

sdo:accepted a owl:DatatypeProperty ;
    rdfs:label "accepted"@en ;
    rdfs:label "akzeptiert"@de ;
    rdfs:domain sdo:EvidenceAssessment ;
    rdfs:range xsd:boolean .

sdo:questionText a owl:DatatypeProperty ;
    rdfs:label "question text"@en ;
    rdfs:label "Fragetext"@de ;
    rdfs:domain sdo:FactQuestion ;
    rdfs:range xsd:string .

sdo:obligationText a owl:DatatypeProperty ;
    rdfs:label "obligation text"@en ;
    rdfs:label "Verpflichtungstext"@de ;
    rdfs:domain sdo:Obligation ;
    rdfs:range xsd:string .

sdo:questionPriority a owl:DatatypeProperty ;
    rdfs:label "question priority"@en ;
    rdfs:label "Fragepriorität"@de ;
    rdfs:comment "A positive integer; lower values are selected before higher values when their Conditions both have Fact Gaps."@en ;
    rdfs:domain sdo:FactQuestion ;
    rdfs:range xsd:positiveInteger .

sdo:outcomeCode a owl:DatatypeProperty ;
    rdfs:label "outcome code"@en ;
    rdfs:label "Ausgangscode"@de ;
    rdfs:domain sdo:DecisionOutcome ;
    rdfs:range xsd:string .

sdo:scopeNote a owl:DatatypeProperty ;
    rdfs:label "scope note"@en ;
    rdfs:label "Geltungsbereichshinweis"@de ;
    rdfs:domain sdo:DecisionContract ;
    rdfs:range xsd:string .

sdo:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from"@en ;
    rdfs:label "gültig ab"@de ;
    rdfs:range xsd:date .

sdo:validUntil a owl:DatatypeProperty ;
    rdfs:label "valid until"@en ;
    rdfs:label "gültig bis"@de ;
    rdfs:range xsd:date .

sdo:decisionDate a owl:DatatypeProperty ;
    rdfs:label "decision date"@en ;
    rdfs:label "Entscheidungsdatum"@de ;
    rdfs:domain sdo:ConformanceCase ;
    rdfs:range xsd:date .

sdo:sourceLocator a owl:DatatypeProperty ;
    rdfs:label "source locator"@en ;
    rdfs:label "Quellenfundort"@de ;
    rdfs:domain sdo:SourceCitation ;
    rdfs:range xsd:string .

sdo:sourceStatement a owl:DatatypeProperty ;
    rdfs:label "source statement"@en ;
    rdfs:label "Quellenaussage"@de ;
    rdfs:domain sdo:SourceCitation ;
    rdfs:range xsd:string .

sdo:contentSha256 a owl:DatatypeProperty ;
    rdfs:label "content SHA-256"@en ;
    rdfs:label "Inhalts-SHA-256"@de ;
    rdfs:domain sdo:SourceRevision ;
    rdfs:range xsd:string .

sdo:byteSize a owl:DatatypeProperty ;
    rdfs:label "byte size"@en ;
    rdfs:label "Byte-Größe"@de ;
    rdfs:domain sdo:SourceRevision ;
    rdfs:range xsd:integer .
