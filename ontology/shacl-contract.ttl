@prefix sco: <https://arturmiller.github.io/spec-compiler/ontology/#> .
@prefix sdo: <https://arturmiller.github.io/spec-compiler/ontology/decision/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://arturmiller.github.io/spec-compiler/ontology/>
    a owl:Ontology ;
    dcterms:title "SHACL Contract Ontology"@en ;
    dcterms:title "SHACL-Vertragsontologie"@de ;
    dcterms:description "Vocabulary for executable product and transformation contracts."@en ;
    dcterms:description "Vokabular für ausführbare Produkt- und Transformationsverträge."@de ;
    dcterms:creator <https://github.com/arturmiller> ;
    dcterms:source <https://github.com/arturmiller/spec-compiler> ;
    vann:preferredNamespacePrefix "sco" ;
    vann:preferredNamespaceUri "https://arturmiller.github.io/spec-compiler/ontology/#" ;
    owl:versionInfo "0.1.0-experimental" .

sco:TransformationContract
    a owl:Class ;
    rdfs:label "Transformation contract"@en ;
    rdfs:label "Transformationsvertrag"@de ;
    rdfs:comment "Versioned description of accepted inputs, emitted outputs, rejection behavior, and result equivalence."@en .

sco:BootstrapProcess
    a owl:Class ;
    rdfs:label "Bootstrap process"@en ;
    rdfs:label "Bootstrap-Prozess"@de ;
    rdfs:comment "Provenance for deriving a candidate implementation from an explicitly identified seed implementation."@en .

sco:EvolutionStrategy
    a owl:Class ;
    rdfs:label "Evolution strategy"@en ;
    rdfs:label "Evolutionsstrategie"@de .

sco:ModifyExistingImplementation
    a owl:NamedIndividual, sco:EvolutionStrategy ;
    rdfs:label "Modify existing implementation"@en ;
    rdfs:label "Bestehende Implementierung verändern"@de .

sco:HttpEndpoint
    a owl:Class ;
    rdfs:label "HTTP endpoint"@en ;
    rdfs:label "HTTP-Endpunkt"@de .

sco:GetEndpoint
    a owl:Class ;
    rdfs:subClassOf sco:HttpEndpoint ;
    rdfs:label "GET endpoint"@en ;
    rdfs:label "GET-Endpunkt"@de ;
    rdfs:comment "HTTP GET endpoint that returns resources described by a SHACL shape."@en .

sco:PostEndpoint
    a owl:Class ;
    rdfs:subClassOf sco:HttpEndpoint ;
    rdfs:label "POST endpoint"@en ;
    rdfs:label "POST-Endpunkt"@de ;
    rdfs:comment "HTTP endpoint invoked with the POST method."@en .

sco:SqlTable
    a owl:Class ;
    rdfs:label "SQL table"@en ;
    rdfs:label "SQL-Tabelle"@de ;
    rdfs:comment "Relational table that stores resources described by a SHACL shape."@en .

sco:CompilerProtocolV1
    a owl:NamedIndividual ;
    rdfs:label "Compiler Protocol v1"@en ;
    rdfs:label "Compilerprotokoll v1"@de ;
    rdfs:comment "Manifest-driven command-line protocol for invoking a compiler on a Product Bundle."@en .

sco:DecisionProtocolV1
    a owl:NamedIndividual ;
    rdfs:label "Decision Protocol v1"@en ;
    rdfs:label "Entscheidungsprotokoll v1"@de ;
    rdfs:comment "Manifest-driven protocol that sends one JSON Decision Request to a product process and observes one JSON Decision Result."@en .

sco:HttpMessage
    a owl:Class ;
    rdfs:label "HTTP message"@en ;
    rdfs:label "HTTP-Nachricht"@de .

sco:HttpRequest
    a owl:Class ;
    rdfs:subClassOf sco:HttpMessage ;
    rdfs:label "HTTP request"@en ;
    rdfs:label "HTTP-Anfrage"@de .

sco:HttpResponse
    a owl:Class ;
    rdfs:subClassOf sco:HttpMessage ;
    rdfs:label "HTTP response"@en ;
    rdfs:label "HTTP-Antwort"@de .

sco:request
    a owl:ObjectProperty ;
    rdfs:label "request"@en ;
    rdfs:label "Anfrage"@de ;
    rdfs:domain sco:HttpEndpoint ;
    rdfs:range sco:HttpRequest .

sco:successResponse
    a owl:ObjectProperty ;
    rdfs:label "successful response"@en ;
    rdfs:label "Erfolgsantwort"@de ;
    rdfs:domain sco:HttpEndpoint ;
    rdfs:range sco:HttpResponse .

sco:invalidRequestResponse
    a owl:ObjectProperty ;
    rdfs:label "response to an invalid request"@en ;
    rdfs:label "Antwort auf eine ungültige Anfrage"@de ;
    rdfs:domain sco:HttpEndpoint ;
    rdfs:range sco:HttpResponse .

sco:invokesContract
    a owl:ObjectProperty ;
    rdfs:label "invokes contract"@en ;
    rdfs:label "ruft Vertrag auf"@de ;
    rdfs:domain sco:HttpEndpoint .

sco:bodySchema
    a owl:DatatypeProperty ;
    rdfs:label "body schema"@en ;
    rdfs:label "Body-Schema"@de ;
    rdfs:domain sco:HttpMessage ;
    rdfs:range rdf:JSON ;
    rdfs:comment "An authored JSON Schema describing the HTTP message body."@en .

sco:bodyPointer
    a owl:DatatypeProperty ;
    rdfs:label "body pointer"@en ;
    rdfs:label "Body-Pointer"@de ;
    rdfs:domain sco:HttpMessage ;
    rdfs:range xsd:string ;
    rdfs:comment "JSON Pointer locating the invoked contract input, result, or error text in the corresponding HTTP message body; the empty string denotes the whole body."@en .

sco:bodyRequired
    a owl:DatatypeProperty ;
    rdfs:label "body required"@en ;
    rdfs:label "Body erforderlich"@de ;
    rdfs:domain sco:HttpRequest ;
    rdfs:range xsd:boolean .

sco:statusCode
    a owl:DatatypeProperty ;
    rdfs:label "HTTP status code"@en ;
    rdfs:label "HTTP-Statuscode"@de ;
    rdfs:domain sco:HttpResponse ;
    rdfs:range xsd:integer .

sco:SQLite
    a owl:NamedIndividual ;
    rdfs:label "SQLite"@en ;
    rdfs:label "SQLite"@de .

sco:implementsContract
    a owl:ObjectProperty ;
    rdfs:label "implements contract"@en ;
    rdfs:label "implementiert Vertrag"@de ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range sco:TransformationContract .

sco:implementsDecisionContract
    a owl:ObjectProperty ;
    rdfs:label "implements decision contract"@en ;
    rdfs:label "implementiert Entscheidungsvertrag"@de ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range sdo:DecisionContract .

sco:bootstrapsProduct
    a owl:ObjectProperty ;
    rdfs:label "bootstraps product"@en ;
    rdfs:label "führt Bootstrap für Produkt durch"@de ;
    rdfs:domain sco:BootstrapProcess ;
    rdfs:range schema:SoftwareApplication .

sco:seedImplementation
    a owl:ObjectProperty ;
    rdfs:label "seed implementation"@en ;
    rdfs:label "Ausgangsimplementierung"@de ;
    rdfs:domain sco:BootstrapProcess ;
    rdfs:range schema:SoftwareApplication .

sco:evolutionStrategy
    a owl:ObjectProperty ;
    rdfs:label "evolution strategy"@en ;
    rdfs:label "Evolutionsstrategie"@de ;
    rdfs:domain sco:BootstrapProcess ;
    rdfs:range sco:EvolutionStrategy .

sco:readsFrom
    a owl:ObjectProperty ;
    rdfs:label "reads from"@en ;
    rdfs:label "liest aus"@de ;
    rdfs:domain sco:GetEndpoint ;
    rdfs:range sco:SqlTable .

sco:returns
    a owl:ObjectProperty ;
    rdfs:label "returns shape"@en ;
    rdfs:label "liefert Shape"@de ;
    rdfs:domain sco:GetEndpoint .

sco:stores
    a owl:ObjectProperty ;
    rdfs:label "stores shape"@en ;
    rdfs:label "speichert Shape"@de ;
    rdfs:domain sco:SqlTable .

sco:pathParameter
    a owl:ObjectProperty ;
    rdfs:label "path parameter"@en ;
    rdfs:label "Pfadparameter"@de ;
    rdfs:domain sco:GetEndpoint .

sco:databaseEngine
    a owl:ObjectProperty ;
    rdfs:label "database engine"@en ;
    rdfs:label "Datenbank-Engine"@de ;
    rdfs:domain sco:SqlTable .

sco:idDatatype
    a owl:ObjectProperty ;
    rdfs:label "identifier datatype"@en ;
    rdfs:label "Bezeichner-Datentyp"@de ;
    rdfs:domain sco:SqlTable .

sco:path
    a owl:DatatypeProperty ;
    rdfs:label "HTTP path"@en ;
    rdfs:label "HTTP-Pfad"@de ;
    rdfs:domain sco:HttpEndpoint ;
    rdfs:range xsd:string .

sco:name
    a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:label "Name"@de ;
    rdfs:range xsd:string .

sco:mapsToColumn
    a owl:DatatypeProperty ;
    rdfs:label "maps to column"@en ;
    rdfs:label "bildet auf Spalte ab"@de ;
    rdfs:range xsd:string .

sco:successStatus
    a owl:DatatypeProperty ;
    rdfs:label "success status"@en ;
    rdfs:label "Erfolgsstatus"@de ;
    rdfs:domain sco:HttpEndpoint ;
    rdfs:range xsd:integer .

sco:mediaType
    a owl:DatatypeProperty ;
    rdfs:label "media type"@en ;
    rdfs:label "Medientyp"@de ;
    rdfs:range xsd:string .

sco:tableName
    a owl:DatatypeProperty ;
    rdfs:label "table name"@en ;
    rdfs:label "Tabellenname"@de ;
    rdfs:domain sco:SqlTable ;
    rdfs:range xsd:string .

sco:idColumn
    a owl:DatatypeProperty ;
    rdfs:label "identifier column"@en ;
    rdfs:label "Bezeichnerspalte"@de ;
    rdfs:domain sco:SqlTable ;
    rdfs:range xsd:string .

sco:idPrimaryKey
    a owl:DatatypeProperty ;
    rdfs:label "identifier is primary key"@en ;
    rdfs:label "Bezeichner ist Primärschlüssel"@de ;
    rdfs:domain sco:SqlTable ;
    rdfs:range xsd:boolean .

sco:idGenerated
    a owl:DatatypeProperty ;
    rdfs:label "identifier is generated"@en ;
    rdfs:label "Bezeichner wird generiert"@de ;
    rdfs:domain sco:SqlTable ;
    rdfs:range xsd:boolean .

sco:inputSpecPattern
    a owl:DatatypeProperty ;
    rdfs:label "input specification pattern"@en ;
    rdfs:label "Eingabespezifikationsmuster"@de ;
    rdfs:domain sco:TransformationContract ;
    rdfs:range xsd:string .

sco:CompilerConformanceFixture
    a owl:Class ;
    rdfs:label "compiler conformance fixture"@en ;
    rdfs:label "Compiler-Konformitäts-Fixture"@de .

sco:conformanceFixture
    a owl:ObjectProperty ;
    rdfs:label "has conformance fixture"@en ;
    rdfs:label "hat Konformitäts-Fixture"@de ;
    rdfs:domain sco:TransformationContract ;
    rdfs:range sco:CompilerConformanceFixture .

sco:fixtureProduct
    a owl:DatatypeProperty ;
    rdfs:label "fixture product"@en ;
    rdfs:label "Fixture-Produkt"@de ;
    rdfs:domain sco:CompilerConformanceFixture ;
    rdfs:range xsd:string .

sco:expectsArtifact
    a owl:DatatypeProperty ;
    rdfs:label "expects artifact"@en ;
    rdfs:label "erwartet Artefakt"@de ;
    rdfs:domain sco:CompilerConformanceFixture ;
    rdfs:range xsd:string .

sco:validFixtureProduct
    a owl:DatatypeProperty ;
    rdfs:label "valid fixture product"@en ;
    rdfs:label "gültiges Fixture-Produkt"@de ;
    rdfs:domain sco:TransformationContract ;
    rdfs:range xsd:string .

sco:generatesArtifact
    a owl:DatatypeProperty ;
    rdfs:label "generates artifact"@en ;
    rdfs:label "generiert Artefakt"@de ;
    rdfs:domain sco:TransformationContract ;
    rdfs:range xsd:string .

sco:rejectsMissingSpecs
    a owl:DatatypeProperty ;
    rdfs:label "rejects missing specifications"@en ;
    rdfs:label "lehnt fehlende Spezifikationen ab"@de ;
    rdfs:domain sco:TransformationContract ;
    rdfs:range xsd:boolean .

sco:deterministicOutput
    a owl:DatatypeProperty ;
    rdfs:label "has deterministic output"@en ;
    rdfs:label "hat deterministische Ausgabe"@de ;
    rdfs:domain sco:TransformationContract ;
    rdfs:range xsd:boolean .

sco:generatesImplementationArtifact
    a owl:DatatypeProperty ;
    rdfs:label "generates implementation artifact"@en ;
    rdfs:label "generiert Implementierungsartefakt"@de ;
    rdfs:domain sco:BootstrapProcess ;
    rdfs:range xsd:string .

sco:inputJsonPointer
    a owl:DatatypeProperty ;
    rdfs:label "input JSON pointer"@en ;
    rdfs:label "Eingabe-JSON-Pointer"@de ;
    rdfs:comment "RFC 6901 pointer identifying a Condition's Fact in the Decision Protocol v1 request."@en ;
    rdfs:domain sdo:Condition ;
    rdfs:range xsd:string .
